NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key. Use the project secret key (preferred) or legacy service_role key.
SUPABASE_SECRET_KEY=

# Daraja sandbox only. Never expose these as NEXT_PUBLIC_* variables.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Existing deployment variable names are supported; BUSINES_SHORT_CODE/PASSKEY aliases also work.
MPESA_STK_SHORTCODE=174379
MPESA_STK_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS callback URL including the random token query parameter.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# Sandbox-only B2C payout credentials. Never use these values for production payouts.
# Set MPESA_SANDBOX_PAYOUT_ENABLED=true only in an isolated Preview/test deployment.
MPESA_SANDBOX_PAYOUT_ENABLED=false
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
# Dedicated Safaricom sandbox recipient; never a group member's real phone number.
MPESA_B2C_TEST_RECIPIENT_PHONE=
MPESA_B2C_RESULT_URL=
MPESA_B2C_QUEUE_TIMEOUT_URL=
MPESA_B2C_CALLBACK_TOKEN=

# Protects the internal scheduled M-Pesa reconciliation endpoint; server-only.
CRON_SECRET=
# Explicitly opt into sandbox collection while the provider catalogue remains disabled.
MPESA_SANDBOX_COLLECTION_ENABLED=false

# Server-only SMTP credentials for outbound group invitation emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Akiba
