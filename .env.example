NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key. Use the project secret key (preferred) or legacy service_role key.
SUPABASE_SECRET_KEY=

# Daraja sandbox only. Never expose these as NEXT_PUBLIC_* variables.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Existing deployment variable names are supported; BUSINES_SHORT_CODE/PASSKEY aliases also work.
MPESA_STK_SHORTCODE=174379
MPESA_STK_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS callback URL including the random token query parameter.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# Protects the internal scheduled M-Pesa reconciliation endpoint; server-only.
CRON_SECRET=
# Explicitly opt into sandbox collection while the provider catalogue remains disabled.
MPESA_SANDBOX_COLLECTION_ENABLED=false
